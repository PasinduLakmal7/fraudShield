# =============================================================================
# FraudShield Environment Variables Example
# =============================================================================

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# API Gateway
GATEWAY_HTTP_PORT=5000
GATEWAY_HTTPS_PORT=5001

# PostgreSQL Databases
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_PORT=5432

IDENTITY_DB_NAME=fraudshield_identity
CUSTOMER_DB_NAME=fraudshield_customer
TRANSACTION_DB_NAME=fraudshield_transaction
FRAUD_DB_NAME=fraudshield_fraud
ALERT_DB_NAME=fraudshield_alert

# RabbitMQ
RABBITMQ_DEFAULT_USER=fraudshield
RABBITMQ_DEFAULT_PASS=fraudshield_dev_pass
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long_12345
JWT_ISSUER=FraudShield.Identity
JWT_AUDIENCE=FraudShield.Clients
JWT_EXPIRATION_MINUTES=60

# Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:5000

